// Грамматика PlantUML Sequence Diagrams
// https://plantuml.com/sequence-diagram

// === Основные правила ===

// ws* в начале строки позволяет отступы (важно для фрагментов)
diagram = { SOI ~ NEWLINE* ~ start_tag ~ NEWLINE* ~ (ws* ~ statement ~ NEWLINE*)* ~ end_tag ~ NEWLINE* ~ EOI }

start_tag = { "@startuml" ~ identifier? }
end_tag = { "@enduml" }

// ВАЖНО: Порядок правил критичен!
// Сначала идут ключевые слова, затем message (который ловит всё остальное)
statement = _{
    comment
    | skinparam
    | title_stmt
    | header_stmt
    | footer_stmt
    | hide_stmt
    | autonumber
    | participant_decl   // Объявления участников - раньше message
    | create_stmt
    | destroy_stmt
    | activate_stmt
    | deactivate_stmt
    | return_stmt
    | note_stmt
    | divider
    | delay
    | space
    | ref_stmt
    | box_start          // Box start/end как отдельные маркеры
    | box_end
    | group_start
    | group_end
    | fragment_start     // Фрагменты - раньше message
    | fragment_else
    | fragment_end
    | message            // Message - последним, так как ловит identifier -> arrow -> identifier
}

// === Комментарии ===

comment = { "'" ~ (!NEWLINE ~ ANY)* }

// === Заголовок ===

title_stmt = { "title" ~ ws+ ~ rest_of_line }
header_stmt = { "header" ~ ws+ ~ rest_of_line }
footer_stmt = { "footer" ~ ws+ ~ rest_of_line }
// hide footbox — скрыть нижние блоки участников
hide_stmt = { "hide" ~ ws+ ~ ("footbox" | "footbox!") }

// === Autonumber ===
// Поддерживаемые варианты:
// autonumber                    - включить с 1
// autonumber 15                 - начать с 15
// autonumber 40 10              - начать с 40, шаг 10
// autonumber 1.1                - многоуровневая нумерация (1.1, 1.2, ...)
// autonumber 1.1.1              - три уровня (1.1.1, 1.1.2, ...)
// autonumber "[00]"             - формат без чисел
// autonumber 10 "[00]"          - начало + формат
// autonumber 10 10 "[00]"       - начало + шаг + формат
// autonumber stop               - остановить
// autonumber resume             - продолжить
// autonumber resume 50          - продолжить с 50
// autonumber resume "[00]"      - продолжить с форматом
// autonumber inc A              - инкремент уровня

autonumber = { 
    "autonumber" ~ ws+ ~ "stop"
    | "autonumber" ~ ws+ ~ "resume" ~ (ws+ ~ autonumber_params)?
    | "autonumber" ~ ws+ ~ "inc" ~ ws+ ~ identifier
    | "autonumber" ~ (ws+ ~ autonumber_params)?
}

autonumber_params = {
    multilevel_number ~ (ws+ ~ number)? ~ (ws+ ~ quoted_string)?  // многоуровневое начало
    | number ~ (ws+ ~ number)? ~ (ws+ ~ quoted_string)?   // числа, опционально формат
    | quoted_string                                      // только формат
}

// Многоуровневая нумерация: 1.1, 1.1.1 и т.д.
multilevel_number = @{ number ~ ("." ~ number)+ }

// === Участники ===
// ВАЖНО: Используем конкретные ключевые слова, а не identifier

participant_decl = {
    participant_type ~ ws+ ~ participant_name ~ 
    (ws+ ~ "as" ~ ws+ ~ simple_identifier)? ~
    (ws+ ~ stereotype)? ~
    (ws+ ~ color)?
    ~ (ws+ ~ "order" ~ ws+ ~ number)?
}

participant_type = {
    "participant"
    | "actor"
    | "boundary"
    | "control"
    | "entity"
    | "database"
    | "collections"
    | "queue"
}

participant_name = { quoted_string | simple_identifier }

// === Create / Destroy ===

create_stmt = { "create" ~ ws+ ~ participant_name }
destroy_stmt = { "destroy" ~ ws+ ~ participant_name }

// === Activate / Deactivate ===

activate_stmt = { "activate" ~ ws+ ~ simple_identifier ~ (ws+ ~ color)? }
deactivate_stmt = { "deactivate" ~ ws+ ~ simple_identifier }
return_stmt = { "return" ~ (ws+ ~ message_text)? }

// === Сообщения ===
// ВАЖНО: Сообщение должно содержать стрелку обязательно
// Синтаксис PlantUML: from -> to++ : message
// где ++ идёт ПОСЛЕ имени получателя (не после стрелки!)

message = {
    participant_ref ~ ws* ~ arrow ~ ws* ~ participant_ref ~ 
    ws* ~ target_activation? ~
    (ws* ~ ":" ~ ws* ~ message_text)?
}

// Активация/деактивация получателя после имени участника
// Поддерживает: ++, --, **, !!, --++, --** и т.д.
// Также может включать цвет: ++ #FFBBBB
target_activation = {
    source_deactivation? ~ target_action ~ (ws* ~ color)?
}

// Деактивация отправителя (--) перед действием над получателем
source_deactivation = { "--" }

// Действие над получателем:
// ++ = активировать
// ** = создать
// !! = уничтожить
target_action = { "++" | "**" | "!!" }

// participant_ref не должен совпадать с ключевыми словами
participant_ref = @{ 
    !reserved_word ~ (LETTER | "_") ~ (LETTER | NUMBER | "_")* 
}

// Зарезервированные слова, которые НЕ могут быть именами участников в message
// ВАЖНО: Проверяем что это слово целиком (не продолжение другого идентификатора)
// Слово считается зарезервированным если за ним не следует буква, цифра или _
reserved_word = {
    ( "participant" | "actor" | "boundary" | "control" | "entity" 
    | "database" | "collections" | "queue" | "create" | "destroy"
    | "activate" | "deactivate" | "return" | "note" | "hnote" | "rnote"
    | "title" | "autonumber" | "skinparam" | "ref" | "box" | "group"
    | "alt" | "else" | "opt" | "loop" | "par" | "break" | "critical" | "end"
    | "@startuml" | "@enduml" ) ~ !(ASCII_ALPHANUMERIC | "_")
}

// === Стрелки ===

arrow = {
    arrow_right | arrow_left
}

// Стрелки направо: ->, -->, ->>, .>, ..>, etc.
arrow_right = {
    line_style_left? ~ 
    arrow_line_right
}

// Стрелки налево: <-, <--, <<-, <., <.., etc.
arrow_left = {
    arrow_line_left ~
    line_style_right?
}

// Линия стрелки направо - порядок важен: длинные варианты первыми
arrow_line_right = @{
    // Двойная сплошная с двойной головкой
    "--" ~ ">>"
    // Двойная пунктирная с двойной головкой
    | ".." ~ ">>"
    // Двойная сплошная с одинарной головкой
    | "--" ~ ">"
    // Двойная пунктирная с одинарной головкой
    | ".." ~ ">"
    // Одинарная сплошная с двойной головкой
    | "-" ~ ">>"
    // Одинарная пунктирная с двойной головкой
    | "." ~ ">>"
    // Одинарная сплошная с одинарной головкой
    | "-" ~ ">"
    // Одинарная пунктирная с одинарной головкой
    | "." ~ ">"
    // Специальные стрелки
    | "-" ~ "-"* ~ ("\\\\" | "\\" | "//" | "/" | "o" | "x")
    | "." ~ "."* ~ ("\\\\" | "\\" | "//" | "/" | "o" | "x")
}

// Линия стрелки налево
arrow_line_left = @{
    // Двойная головка с двойной сплошной
    "<<" ~ "--"
    // Двойная головка с двойной пунктирной
    | "<<" ~ ".."
    // Двойная головка с одинарной сплошной
    | "<<" ~ "-"
    // Двойная головка с одинарной пунктирной
    | "<<" ~ "."
    // Одинарная головка с двойной сплошной
    | "<" ~ "--"
    // Одинарная головка с двойной пунктирной
    | "<" ~ ".."
    // Одинарная головка с одинарной сплошной
    | "<" ~ "-"
    // Одинарная головка с одинарной пунктирной
    | "<" ~ "."
    // Специальные стрелки
    | ("\\\\" | "\\" | "//" | "/" | "o" | "x") ~ "-" ~ "-"*
    | ("\\\\" | "\\" | "//" | "/" | "o" | "x") ~ "." ~ "."*
}

line_style_left = { "[" ~ line_color? ~ "]" }
line_style_right = { "[" ~ line_color? ~ "]" }

// DEPRECATED: activation_mark перенесён в target_activation
// Оставлено для обратной совместимости со старыми тестами
activation_mark = { "++" | "--" | "**" | "!!" }

line_color = { "#" ~ hex_color }

message_text = { (!NEWLINE ~ ANY)+ }

// === Заметки ===

// ВАЖНО: note_multi идёт первым. Форма `note over A` ... `end note`
// начинается так же, как однострочная `note over A: текст`, и при обратном
// порядке перехватывалась однострочным правилом, из-за чего многострочная
// заметка давала ошибку парсинга.
note_stmt = {
    note_multi
    | note_over
    | note_left_right
    | hnote
    | rnote
}

// "note over Alice, Bob: text" или "note over Alice: text"
note_over = {
    "note" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ 
    (ws* ~ ":" ~ ws* ~ note_text)?
}

// "note left: text" или "note right of Alice: text"
note_left_right = {
    "note" ~ ws+ ~ note_position ~ ws* ~
    (("of" | ":") ~ ws* ~ (identifier_list ~ ws* ~ ":")?)? ~
    ws* ~ note_text?
}

// Многострочная заметка. Поддерживаются формы:
//   note over A
//   note over A, B
//   note left of A
//   note right of A
//   note left
note_multi = {
    "note" ~ ws+ ~
    (
        "over" ~ ws+ ~ identifier_list
        | note_position ~ (ws+ ~ "of" ~ ws+ ~ identifier_list)?
        | note_position
    ) ~ ws* ~
    NEWLINE ~ note_body ~ "end" ~ ws* ~ "note"
}

hnote = { "hnote" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ ws* ~ ":" ~ ws* ~ note_text }
rnote = { "rnote" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ ws* ~ ":" ~ ws* ~ note_text }

note_position = { "left" | "right" | "across" }

identifier_list = { simple_identifier ~ (ws* ~ "," ~ ws* ~ simple_identifier)* }

note_text = { (!NEWLINE ~ ANY)* }
note_body = { (!("end" ~ ws* ~ "note") ~ ANY)* }

// === Разделители и задержки ===

divider = { "==" ~ ws* ~ divider_text? ~ ws* ~ "==" }
divider_text = { (!("==" | NEWLINE) ~ ANY)* }

delay = { "..." ~ ws* ~ delay_text? ~ ws* ~ "..."? }
delay_text = { (!("..." | NEWLINE) ~ ANY)* }

space = { "|||" | "||" ~ number ~ "||" }

// === Ref ===

ref_stmt = { "ref" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ ws* ~ (":" ~ ws* ~ ref_text | NEWLINE ~ ref_body ~ "end" ~ ws* ~ "ref") }
ref_text = { (!NEWLINE ~ ANY)* }
ref_body = { (!("end" ~ ws* ~ "ref") ~ ANY)* }

// === Box ===
// box "Title" #Color ... end box

box_start = { "box" ~ (ws+ ~ box_title)? ~ (ws* ~ color)? }
box_title = { quoted_string | simple_identifier }
box_end = { "end" ~ ws+ ~ "box" }

// === Group (simple) ===

// group Название ... end   (или end group)
//
// Разбирается как два маркера (начало и конец), как и фрагменты: так
// парсер использует для вложенности общий стек. Метка необязательна —
// `group` без названия допустим в PlantUML.
group_start = { "group" ~ (ws+ ~ group_label)? }
group_end = { "end" ~ (ws+ ~ "group")? }

group_label = { (!NEWLINE ~ ANY)+ }

// === Фрагменты (alt, opt, loop, etc.) ===

fragment_start = {
    fragment_type ~ (ws+ ~ fragment_condition)?
}

fragment_type = @{
    "alt"
    | "opt"
    | "loop"
    | "par"
    | "break"
    | "critical"
}

fragment_condition = { (!NEWLINE ~ ANY)+ }

fragment_else = { "else" ~ (ws+ ~ fragment_condition)? }

fragment_end = { "end" ~ !(ws* ~ ("note" | "ref" | "box")) }

// === Skinparam ===

skinparam = { 
    "skinparam" ~ ws+ ~ skinparam_name ~ ws+ ~ skinparam_value
    | "skinparam" ~ ws+ ~ skinparam_name ~ ws* ~ "{" ~ ws* ~ NEWLINE ~ (skinparam_line ~ NEWLINE)* ~ "}"
}

skinparam_name = { (LETTER | "_")+ }
skinparam_value = { (!NEWLINE ~ ANY)+ }
skinparam_line = { ws* ~ skinparam_name ~ ws+ ~ skinparam_value }

// === Базовые токены ===

// Обычный идентификатор
simple_identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

// Для обратной совместимости
identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

quoted_string = { "\"" ~ inner_string ~ "\"" }
inner_string = { (!("\"") ~ ANY)* }

stereotype = { "<<" ~ (!(">>") ~ ANY)* ~ ">>" }

color = { "#" ~ color_value }
color_value = @{ ASCII_HEX_DIGIT{3,8} | ASCII_ALPHA+ }
hex_color = @{ ASCII_HEX_DIGIT{3,8} }

number = @{ ASCII_DIGIT+ }

rest_of_line = { (!NEWLINE ~ ANY)* }

// === Пробельные символы ===
// ВАЖНО: Не используем WHITESPACE для implicit whitespace handling,
// чтобы иметь полный контроль над парсингом

ws = _{ " " | "\t" }
NEWLINE = _{ "\r\n" | "\n" | "\r" }
