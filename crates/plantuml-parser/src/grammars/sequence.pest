// Грамматика PlantUML Sequence Diagrams
// https://plantuml.com/sequence-diagram

// === Основные правила ===

// ws* в начале строки позволяет отступы (важно для фрагментов)
diagram = { SOI ~ NEWLINE* ~ start_tag ~ NEWLINE* ~ (ws* ~ statement? ~ NEWLINE)* ~ ws* ~ end_tag ~ NEWLINE* ~ EOI }

start_tag = { "@startuml" ~ identifier? }
end_tag = { "@enduml" }

// ВАЖНО: Порядок правил критичен!
// Сначала идут ключевые слова, затем message (который ловит всё остальное)
statement = _{
    comment
    | skinparam
    | title_stmt
    | header_stmt
    | footer_stmt
    | direction_stmt
    | scale_stmt
    | legend_stmt
    | mainframe_stmt
    | newpage_stmt
    | hide_stmt
    | autonumber
    | colon_actor_decl   // Короткая форма актёра `:Alice:`
    | participant_decl   // Объявления участников - раньше message
    | create_stmt
    | destroy_stmt
    | activate_stmt
    | deactivate_stmt
    | return_stmt
    | note_stmt
    | divider
    | delay
    | space
    | ref_stmt
    | box_start          // Box start/end как отдельные маркеры
    | box_end
    | group_start
    | group_end
    | fragment_start     // Фрагменты - раньше message
    | fragment_else
    | fragment_end
    | duration_stmt      // `{start} <-> {end} : текст` — раньше message
    | message            // Message - последним, так как ловит identifier -> arrow -> identifier
}

// === Комментарии ===

// Комментарии: строчный `' текст` и БЛОЧНЫЙ `/' ... '/`.
//
// Блочная форма встречается в стандартной библиотеке — например в C4
// (`/' @deprecated in favor of UpdateElementStyle '/`). Без неё разбор
// диаграмм с таким включением падал.
comment = {
    line_comment
    | block_comment
}
line_comment = { "'" ~ (!NEWLINE ~ ANY)* }
block_comment = { "/'" ~ (!"'/" ~ ANY)* ~ "'/" }

// === Заголовок ===

title_stmt = { "title" ~ ws+ ~ rest_of_line }
header_stmt = { "header" ~ ws+ ~ rest_of_line }
footer_stmt = { "footer" ~ ws+ ~ rest_of_line }

// Легенда: многострочный блок между `legend` и `endlegend`.
// В PlantUML есть также формы legend left/right/center — они тоже
// принимаются, так как текст всё равно берётся до `endlegend`.
legend_stmt = { "legend" ~ rest_of_line? ~ NEWLINE ~ (!("endlegend") ~ ANY)* ~ "endlegend" }

// Рамка вокруг диаграммы: `mainframe Заголовок`
mainframe_stmt = { "mainframe" ~ rest_of_line? }

// Разрыв страницы: `newpage` с необязательным заголовком
newpage_stmt = { "newpage" ~ rest_of_line? }
// hide footbox — скрыть нижние блоки участников
hide_stmt = { "hide" ~ ws+ ~ ("footbox" | "footbox!") }

// === Autonumber ===
// Поддерживаемые варианты:
// autonumber                    - включить с 1
// autonumber 15                 - начать с 15
// autonumber 40 10              - начать с 40, шаг 10
// autonumber 1.1                - многоуровневая нумерация (1.1, 1.2, ...)
// autonumber 1.1.1              - три уровня (1.1.1, 1.1.2, ...)
// autonumber "[00]"             - формат без чисел
// autonumber 10 "[00]"          - начало + формат
// autonumber 10 10 "[00]"       - начало + шаг + формат
// autonumber stop               - остановить
// autonumber resume             - продолжить
// autonumber resume 50          - продолжить с 50
// autonumber resume "[00]"      - продолжить с форматом
// autonumber inc A              - инкремент уровня

autonumber = { 
    "autonumber" ~ ws+ ~ "stop"
    | "autonumber" ~ ws+ ~ "resume" ~ (ws+ ~ autonumber_params)?
    | "autonumber" ~ ws+ ~ "inc" ~ ws+ ~ identifier
    | "autonumber" ~ (ws+ ~ autonumber_params)?
}

autonumber_params = {
    multilevel_number ~ (ws+ ~ number)? ~ (ws+ ~ quoted_string)?  // многоуровневое начало
    | number ~ (ws+ ~ number)? ~ (ws+ ~ quoted_string)?   // числа, опционально формат
    | quoted_string                                      // только формат
}

// Многоуровневая нумерация: 1.1, 1.1.1 и т.д.
multilevel_number = @{ number ~ ("." ~ number)+ }

// === Участники ===
// ВАЖНО: Используем конкретные ключевые слова, а не identifier

// Короткая форма актёра: `:Alice:`.
//
// Проверяется ПЕРЕД message: иначе `:Alice:` разберётся как начало
// сообщения. Стрелка после закрывающего двоеточия означает, что это уже
// сообщение, а не объявление.
colon_actor_decl = { ":" ~ colon_actor_name ~ ":" ~ !(ws* ~ arrow) }
colon_actor_name = @{ (!(":" | NEWLINE) ~ ANY)+ }

participant_decl = {
    participant_type ~ ws+ ~ participant_name ~ 
    (ws+ ~ "as" ~ ws+ ~ simple_identifier)? ~
    (ws+ ~ stereotype)? ~
    (ws+ ~ color)?
    ~ (ws+ ~ "order" ~ ws+ ~ number)?
}

participant_type = {
    "participant"
    | "actor"
    | "boundary"
    | "control"
    | "entity"
    | "database"
    | "collections"
    | "queue"
}

participant_name = { quoted_string | simple_identifier }

// === Create / Destroy ===

// PlantUML допускает обе формы: `create B` и `create participant B`.
// Вторая раньше не разбиралась вовсе.
create_stmt = { "create" ~ ws+ ~ (participant_type ~ ws+)? ~ participant_name }
destroy_stmt = { "destroy" ~ ws+ ~ participant_name }

// === Activate / Deactivate ===

activate_stmt = { "activate" ~ ws+ ~ simple_identifier ~ (ws+ ~ color)? }
deactivate_stmt = { "deactivate" ~ ws+ ~ simple_identifier }
return_stmt = { "return" ~ (ws+ ~ message_text)? }

// === Сообщения ===
// ВАЖНО: Сообщение должно содержать стрелку обязательно
// Синтаксис PlantUML: from -> to++ : message
// где ++ идёт ПОСЛЕ имени получателя (не после стрелки!)

message = {
    parallel_prefix? ~ anchor_tag? ~
    (boundary_left_mark | participant_ref) ~ ws* ~ arrow ~ ws* ~
    (boundary_right_mark | participant_ref) ~
    ws* ~ target_activation? ~
    (ws* ~ ":" ~ ws* ~ message_text)?
}

// `& A -> B` кладёт сообщение на строку предыдущего, устаревшее `/ note ...`
// делает то же для заметки.
parallel_prefix = { ("&" | "/") ~ ws+ }

// Якорь сообщения: `{start} A -> B`. Пара якорей задаёт стрелку длительности.
anchor_tag = { "{" ~ anchor_name ~ "}" ~ ws* }
anchor_name = @{ (LETTER | NUMBER | "_")+ }

// `{start} <-> {end} : время выполнения`
duration_stmt = { anchor_tag ~ "<->" ~ ws* ~ anchor_tag ~ (":" ~ ws* ~ message_text)? }

// Конец сообщения за краем диаграммы: `[-> A`, `? -> A`, `A ->]`, `A ->?`.
boundary_left_mark = @{ ("[" | "?") ~ &(ws | "-" | "." | "<" | "o" | "x" | "\\" | "/") }
boundary_right_mark = @{ ("]" | "?") ~ &(ws | NEWLINE | EOI) }

// Активация/деактивация получателя после имени участника
// Поддерживает: ++, --, **, !!, --++, --** и т.д.
// Также может включать цвет: ++ #FFBBBB
target_activation = {
    source_deactivation? ~ target_action ~ (ws* ~ color)?
    // Только деактивация: `A -> B-- : текст`. `--` стоит сразу после имени
    // получателя и означает «деактивировать», без последующего действия.
    // Раньше такая форма не разбиралась вовсе.
    | source_deactivation ~ (ws* ~ color)?
}

// Деактивация отправителя (--) перед действием над получателем
source_deactivation = { "--" }

// Действие над получателем:
// ++ = активировать
// ** = создать
// !! = уничтожить
target_action = { "++" | "**" | "!!" }

// participant_ref не должен совпадать с ключевыми словами
participant_ref = @{ 
    // Короткая форма актёра: `:Alice:`. PlantUML принимает её и в
    // объявлениях, и в сообщениях (`:Alice: -> :Bob: : текст`).
    ":" ~ (!(":" | NEWLINE) ~ ANY)+ ~ ":"
    | !reserved_word ~ (LETTER | "_") ~ (LETTER | NUMBER | "_")* 
}

// Зарезервированные слова, которые НЕ могут быть именами участников в message
// ВАЖНО: Проверяем что это слово целиком (не продолжение другого идентификатора)
// Слово считается зарезервированным если за ним не следует буква, цифра или _
reserved_word = {
    ( "participant" | "actor" | "boundary" | "control" | "entity" 
    | "database" | "collections" | "queue" | "create" | "destroy"
    | "activate" | "deactivate" | "return" | "note" | "hnote" | "rnote"
    | "title" | "autonumber" | "skinparam" | "ref" | "box" | "group"
    | "alt" | "else" | "opt" | "loop" | "par" | "break" | "critical" | "end"
    | "@startuml" | "@enduml" ) ~ !(ASCII_ALPHANUMERIC | "_")
}

// === Стрелки ===

// Стрелка целиком одним атомарным токеном: разбор по частям (наконечники,
// цвет в скобках, смещение) делает парсер, потому что форм много:
// `->`, `-->`, `->>`, `->x`, `->o`, `-\\`, `//--`, `<->`, `o<->o`, `-[#red]>`,
// `->(10)`.
arrow = @{
    left_part ~ arrow_body ~ right_part? ~ arrow_shift?
    | arrow_body ~ right_part ~ arrow_shift?
}

left_part = _{ left_deco? ~ left_head | left_deco ~ &arrow_body }
left_head = _{ "<<" | "<" | "\\\\" | "\\" | "//" | "/" }
left_deco = _{ "o" | "x" }

right_part = _{ right_head ~ right_deco? | right_deco }
right_head = _{ ">>" | ">" | "\\\\" | "\\" | "//" | "/" }
// Крест и кружок — наконечники, только если за ними пробел или конец
// стрелки: иначе `A ->xavier` читалось бы как стрелка с крестом.
right_deco = _{ ("o" | "x") ~ &(ws | "]" | "?" | "(" | NEWLINE) }

// Тело: тире и точки, внутри которых может стоять `[#red]` или `[bold]`.
arrow_body = _{ line_char+ ~ (arrow_style ~ line_char*)? }
line_char = _{ "-" | "." }
arrow_style = _{ "[" ~ (!("]" | NEWLINE) ~ ANY)* ~ "]" }
arrow_shift = _{ "(" ~ ASCII_DIGIT+ ~ ")" }

// DEPRECATED: activation_mark перенесён в target_activation
// Оставлено для обратной совместимости со старыми тестами
activation_mark = { "++" | "--" | "**" | "!!" }

message_text = { (!NEWLINE ~ ANY)+ }

// === Заметки ===

// ВАЖНО: note_multi идёт первым. Форма `note over A` ... `end note`
// начинается так же, как однострочная `note over A: текст`, и при обратном
// порядке перехватывалась однострочным правилом, из-за чего многострочная
// заметка давала ошибку парсинга.
note_stmt = {
    parallel_prefix? ~ (note_multi
    | note_over
    | note_left_right
    | hnote
    | rnote)
}

// "note over Alice, Bob: text" или "note over Alice: text"
note_over = {
    "note" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ 
    (ws* ~ ":" ~ ws* ~ note_text)?
}

// "note left: text" или "note right of Alice: text"
note_left_right = {
    "note" ~ ws+ ~ note_position ~ ws* ~
    (("of" | ":") ~ ws* ~ (identifier_list ~ ws* ~ ":")?)? ~
    ws* ~ note_text?
}

// Многострочная заметка. Поддерживаются формы:
//   note over A
//   note over A, B
//   note left of A
//   note right of A
//   note left
note_multi = {
    "note" ~ ws+ ~
    (
        "over" ~ ws+ ~ identifier_list
        | note_position ~ (ws+ ~ "of" ~ ws+ ~ identifier_list)?
        | note_position
    ) ~ ws* ~
    NEWLINE ~ note_body ~ "end" ~ ws* ~ "note"
}

hnote = { "hnote" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ ws* ~ ":" ~ ws* ~ note_text }
rnote = { "rnote" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ ws* ~ ":" ~ ws* ~ note_text }

note_position = { "left" | "right" | "across" }

identifier_list = { simple_identifier ~ (ws* ~ "," ~ ws* ~ simple_identifier)* }

note_text = { (!NEWLINE ~ ANY)* }
note_body = { (!("end" ~ ws* ~ "note") ~ ANY)* }

// === Разделители и задержки ===

divider = { "==" ~ ws* ~ divider_text? ~ ws* ~ "==" }
divider_text = { (!("==" | NEWLINE) ~ ANY)* }

// Две формы задержки:
//   `...`            — многоточие, необязательный текст до или после
//   `delay: <текст>` — слово delay С ДВОЕТОЧИЕМ
//
// Форма без двоеточия (`delay 10 минут`) в PlantUML не существует:
// сервер отвечает 400. Проверено на plantuml.com.
delay = {
    "delay" ~ ws* ~ ":" ~ ws* ~ delay_text
    | "..." ~ ws* ~ delay_text? ~ ws* ~ "..."?
}
delay_text = { (!("..." | NEWLINE) ~ ANY)* }

space = { "|||" | "||" ~ number ~ "||" }

// === Ref ===

ref_stmt = { "ref" ~ ws+ ~ "over" ~ ws+ ~ identifier_list ~ ws* ~ (":" ~ ws* ~ ref_text | NEWLINE ~ ref_body ~ "end" ~ ws* ~ "ref") }
ref_text = { (!NEWLINE ~ ANY)* }
ref_body = { (!("end" ~ ws* ~ "ref") ~ ANY)* }

// === Box ===
// box "Title" #Color ... end box

box_start = { "box" ~ (ws+ ~ box_title)? ~ (ws* ~ color)? }
box_title = { quoted_string | simple_identifier }
box_end = { "end" ~ ws+ ~ "box" }

// === Group (simple) ===

// group Название ... end   (или end group)
//
// Разбирается как два маркера (начало и конец), как и фрагменты: так
// парсер использует для вложенности общий стек. Метка необязательна —
// `group` без названия допустим в PlantUML.
group_start = { "group" ~ !(LETTER | NUMBER | "_") ~ (ws+ ~ group_label)? }
group_end = { "end" ~ !(LETTER | NUMBER | "_") ~ (ws+ ~ "group")? }

group_label = { (!NEWLINE ~ ANY)+ }

// === Фрагменты (alt, opt, loop, etc.) ===

// Цвета: `alt#Gold #LightBlue условие` — рамка, затем фон.
fragment_start = {
    fragment_type ~ color? ~ (ws+ ~ fragment_background)? ~ (ws+ ~ fragment_condition)?
}

fragment_type = @{
    ("alt" | "opt" | "loop" | "par" | "break" | "critical") ~ !(LETTER | NUMBER | "_")
}

// Фон — цвет, за которым пробел или конец строки; иначе это начало условия.
fragment_background = _{ &(color ~ (ws | NEWLINE)) ~ color }

fragment_condition = { (!NEWLINE ~ ANY)+ }

fragment_else = { "else" ~ !(LETTER | NUMBER | "_") ~ (ws* ~ color ~ &(ws | NEWLINE))? ~ (ws+ ~ fragment_condition)? }

fragment_end = { "end" ~ !(LETTER | NUMBER | "_") ~ !(ws* ~ ("note" | "ref" | "box")) }

// === Skinparam ===

skinparam = { 
    "skinparam" ~ ws+ ~ skinparam_name ~ ws+ ~ skinparam_value
    | "skinparam" ~ ws+ ~ skinparam_name ~ ws* ~ "{" ~ ws* ~ NEWLINE ~ (skinparam_line ~ NEWLINE)* ~ "}"
}

skinparam_name = { (LETTER | "_")+ }
skinparam_value = { (!NEWLINE ~ ANY)+ }
skinparam_line = { ws* ~ skinparam_name ~ ws+ ~ skinparam_value }

// === Базовые токены ===

// Обычный идентификатор
simple_identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

// Для обратной совместимости
identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

quoted_string = { "\"" ~ inner_string ~ "\"" }
inner_string = { (!("\"") ~ ANY)* }

stereotype = { "<<" ~ (!(">>") ~ ANY)* ~ ">>" }

color = { "#" ~ color_value }
color_value = @{ ASCII_HEX_DIGIT{3,8} | ASCII_ALPHA+ }
hex_color = @{ ASCII_HEX_DIGIT{3,8} }

number = @{ ASCII_DIGIT+ }

rest_of_line = { (!NEWLINE ~ ANY)* }

// === Пробельные символы ===
// ВАЖНО: Не используем WHITESPACE для implicit whitespace handling,
// чтобы иметь полный контроль над парсингом

ws = _{ " " | "\t" }
NEWLINE = _{ "\r\n" | "\n" | "\r" }

// Направление раскладки: `top to bottom direction`, `left to right direction`.
// Ключевое слово было только в usecase-грамматике; в class и sequence
// такие строки не разбирались вовсе.
direction_stmt = { direction_kind ~ ws+ ~ "direction" }
direction_kind = { "top" ~ ws+ ~ "to" ~ ws+ ~ "bottom" | "left" ~ ws+ ~ "to" ~ ws+ ~ "right" }

// Масштаб диаграммы: `scale 2`, `scale 1.5`, `scale 200 width`.
// В sequence и class правила не было вовсе.
scale_stmt = { "scale" ~ ws+ ~ rest_of_line }
