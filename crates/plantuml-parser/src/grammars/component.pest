// Грамматика PlantUML Component Diagrams
// https://plantuml.com/component-diagram

// === Основные правила ===

diagram = { SOI ~ NEWLINE* ~ start_tag ~ NEWLINE* ~ body ~ end_tag ~ NEWLINE* ~ EOI }

start_tag = { "@startuml" ~ identifier? }
end_tag = { "@enduml" }

// Строка из одних пробелов допустима: `ws*` съедает пробелы, затем
// проверяется перевод строки. Без этого пустая строка с отступом
// (она встречается в развёрнутом выводе стандартной библиотеки)
// обрывала разбор.
// Каждая итерация ОБЯЗАНА съесть перевод строки: иначе повторение
// может совпасть с пустой строкой, и pest отвергает грамматику.
// `statement?` делает допустимой строку из одних пробелов — такие
// встречаются в развёрнутом выводе стандартной библиотеки.
// Порядок правил важен: `ws*` идёт ВНУТРИ `statement`, а не после него.
// Отдельный `ws*` перед NEWLINE съедал пробел перед `:` и ломал метки
// связей (`A -> B : текст` переставало разбираться). Хвостовой пробел
// обрабатывает само правило оператора.
body = { (ws* ~ statement? ~ NEWLINE)* ~ ws* }

// ВАЖНО: Порядок правил критичен!
// 1. package_def должна идти ДО component_def, чтобы node/cloud с телом {} парсились как контейнеры
// 2. connection должна идти ПОСЛЕ component_def, чтобы bracket_component парсился корректно
statement = _{
    comment
    | skinparam
    | title_stmt
    | hide_stmt
    | scale_stmt
    | package_def
    | nested_package_def
    | interface_def
    | archimate_def
    | connection
    | component_def
    | sprite_stmt
    | style_stmt
    | note_stmt
}

// Хвостовые пробелы в строке допустимы.
//
// PlantUML развёртывает макросы с пустыми аргументами, и в строке
// остаётся пробел перед переводом строки:
//   `rectangle "== Пользователь" <<person>> as a `
// Без этого правила разбор падал на трейлинг-пробеле.

// === Archimate ===
// archimate #Layer "Name" as alias
// Слой задаёт цвет и стереотип элемента; поддерживаемые слои PlantUML:
// Business, Application, Technology, Motivation, Strategy, Physical,
// Implementation.
archimate_def = {
    "archimate" ~ ws+ ~ archimate_layer ~ ws+ ~ quoted_string ~
    (ws+ ~ "as" ~ ws+ ~ identifier)?
}

archimate_layer = @{ "#" ~ (ASCII_ALPHA)+ }

// === Комментарии ===

// Комментарии: строчный `' текст` и БЛОЧНЫЙ `/' ... '/`.
//
// Блочная форма встречается в стандартной библиотеке — например в C4
// (`/' @deprecated in favor of UpdateElementStyle '/`). Без неё разбор
// диаграмм с таким включением падал.
comment = {
    line_comment
    | block_comment
}
line_comment = { "'" ~ (!NEWLINE ~ ANY)* }
block_comment = { "/'" ~ (!"'/" ~ ANY)* ~ "'/" }

// === Заголовок и настройки ===

title_stmt = { "title" ~ ws+ ~ rest_of_line }
hide_stmt = { "hide" ~ ws+ ~ rest_of_line }
scale_stmt = { "scale" ~ ws+ ~ rest_of_line }

// === Определение компонента ===

// Простой компонент без тела: component Name, [Component], database DB
// Компоненты с телом {} обрабатываются через package_def/nested_package_def
// ВАЖНО: Используем negative lookahead чтобы не захватывать node/folder/frame с телом {}
component_def = {
    container_keyword ~ ws+ ~ component_name ~ name_suffix? ~ color_part? ~ !("{") ~ ws*
    // `device`/`agent` могут быть и контейнерами (с телом) — тогда их
    // разбирает package_def. Здесь они принимаются только БЕЗ тела.
    | non_container_keyword ~ ws+ ~ component_name ~ name_suffix? ~ color_part?
        ~ !(ws* ~ "{" ~ NEWLINE) ~ ws*
    | bracket_component ~ name_suffix? ~ color_part? ~ ws*
}

// Ключевые слова, которые МОГУТ быть контейнерами (с телом {})
// Для них нужна проверка на отсутствие { чтобы отличить компонент от контейнера
// Ключевые слова, которые могут быть КОНТЕЙНЕРАМИ (принимать тело).
//
// Список сверен с официальной документацией (plantuml.com/en/deployment-diagram,
// раздел «Nestable elements»): action, artifact, card, cloud, component,
// database, file, folder, frame, hexagon, node, package, process, queue,
// rectangle, stack, storage.
//
// `collections` в него НЕ входит: у него тела не бывает.
container_keyword = {
    "node"
    | "folder"
    | "frame"
    | "cloud"
    | "rectangle"
    | "database"
    | "storage"
    | "queue"
    | "file"
    | "artifact"
    | "card"
    | "hexagon"
    | "stack"
    | "action"
    | "process"
    | "component"
}

// Ключевые слова, которые НЕ могут быть контейнерами (всегда компоненты)
// Элементы, которые телом НЕ обладают.
//
// `device` убран: такого ключевого слова в PlantUML нет — сервер отвечает
// 400 на любую форму (`device D1`, `device "D" as d`, `device D { ... }`),
// и в официальном списке объявляемых элементов его тоже нет.
// Добавлены отсутствовавшие circle, label, person, collections.
non_container_keyword = {
    "component"
    | "actor"
    | "agent"
    | "control"
    | "boundary"
    | "entity"
    | "circle"
    | "label"
    | "person"
    | "collections"
}

// Ключевые слова для типов компонентов (все вместе для parse_component_type)
component_keyword = {
    container_keyword | non_container_keyword
}

// [Component Name] синтаксис
bracket_component = { "[" ~ bracket_content ~ "]" }
bracket_content = { (!"]" ~ ANY)+ }

component_name = { quoted_string | simple_identifier }

// === Определение интерфейса ===

interface_def = {
    interface_provided
    | interface_required
    | interface_simple
}

// () Interface - предоставляемый
interface_provided = { "()" ~ ws* ~ interface_name ~ alias_part? }

// ( Interface - требуемый (полукруг)
interface_required = { "(" ~ ws* ~ interface_name ~ ws* ~ ")" ~ alias_part? }

// interface Name
interface_simple = { "interface" ~ ws+ ~ interface_name ~ alias_part? ~ stereotype_part? }

interface_name = { quoted_string | simple_identifier }

// === Пакеты/контейнеры ===

// Основной package (верхнего уровня или вложенный)
package_def = {
    package_keyword ~ ws+ ~ package_name ~ name_suffix? ~ color_part? ~ ws* ~ "{" ~ NEWLINE ~
    package_body ~
    "}"
}

// Вложенный package (может содержать другие packages)
nested_package_def = {
    nested_package_keyword ~ ws+ ~ package_name ~ name_suffix? ~ color_part? ~ ws* ~ "{" ~ NEWLINE ~
    package_body ~
    "}"
}

// Тело пакета может содержать вложенные пакеты
// Используем negative lookahead чтобы остановиться перед закрывающей скобкой
// Пустые строки (только пробелы и переводы строк) игнорируются
package_body = { (package_line)* ~ ws* }

// Строка внутри пакета: либо statement, либо пустая строка
package_line = _{
    ws* ~ !("}" ~ NEWLINE?) ~ package_statement ~ NEWLINE*
    | ws* ~ NEWLINE  // пустая строка
}

package_statement = _{
    comment
    | skinparam
    | nested_package_def
    | package_def
    | interface_def
    | connection
    | component_def
    | note_stmt
}

// Контейнерные ключевые слова. Ссылаемся на `container_keyword`, чтобы
// списки не разъезжались: раньше это был отдельный перечень, и добавление
// `action`/`process` в один список не давало эффекта во втором.
//
// `collections` здесь больше нет: тела он не принимает.
package_keyword = {
    "package"
    | container_keyword
}

// Ключевые слова, которые могут быть и компонентом, и контейнером
nested_package_keyword = {
    "node"
    | "folder"
    | "frame"
}

package_name = { quoted_string | simple_identifier }

// === Связи ===

connection = {
    connection_from ~ ws* ~ arrow ~ ws* ~ connection_to ~ connection_label?
}

// Имя конца связи. Поддерживается и quoted-форма: связи между элементами
// с именами в кавычках (`"app.jar" --> pg`) — обычная запись PlantUML,
// раньше такие связи не разбирались вовсе.
connection_end = _{
    bracket_component
    | interface_ref
    | quoted_string
    | simple_identifier
}

connection_from = { connection_end }

connection_to = { connection_end }

// Ссылка на интерфейс
interface_ref = { "()" ~ ws* ~ simple_identifier | "(" ~ simple_identifier ~ ")" }

// Стрелки
// Между сторонами стрелки может стоять стиль линии: `-[#red]->`,
// `-[dashed]->`. Раньше такие связи не разбирались вовсе.
arrow = {
    arrow_style_before_line
    // НАПРАВЛЕННЫЕ стрелки идут ПЕРЕД украшенными: `-DOWN->>` иначе
    // перехватывается правилом украшений как `-DOWN-` + `>>`.
    | directed_arrow
    // Украшенные связи проверяются ПЕРЕД обычными: иначе `-->>` разберётся
    // как `-->` с остатком `>`, а `-0-` — как `-0` с остатком `-`.
    | arrow_decorated
    | arrow_dashed
    | arrow_solid
    // Простая ассоциация со стилем, но без наконечника: `A -- B`, `A -[#red]- B`.
    | ("-" | "." | "~" | "=")+ ~ arrow_style ~ ("-" | "." | "~" | "=")*
    // Ассоциация без наконечника и без стиля: `A -- B`, `A ~~ B`, `A == B`.
    | ("-" | "." | "~" | "="){1,3}
}

// Связи с украшением на конце: `--*`, `--o`, `--+`, `--#`, `-->>`,
// `--0`, `--^`, `--(0`, а также «кружковые» `-0-`, `-0)-`, `-(0-`,
// `-(0)-` и линии `~~`, `==`.
// Стрелка с ЯВНЫМ направлением: `-DOWN->>`, `-down->`, `.up.>`.
//
// Стандартная библиотека C4 строит их через `$down("-","->>")`,
// поэтому форма встречается постоянно.
directed_arrow = {
    ("-" | "." | "~" | "="){1,3} ~ arrow_direction ~ ("-" | "."){1,3} ~ ">" ~ ">"?
}

arrow_decorated = {
    // Кружковые связи проверяются первыми: иначе `-0-` разберётся как
    // украшение `-0` с остатком `-`.
    //
    // `<-0->`, `<-0)-`, `<-(0)->`
    "<" ~ ("-" | ".") ~ ("0" | "(" ~ "0"? ) ~ ")"? ~ ("-" | ".") ~ arrow_head?
    | "<" ~ ("0" | "(" ~ "0"? ) ~ ")"? ~ ("-" | ".") ~ arrow_head?
    // `-0-`, `-0)-`, `-(0-`, `-(0)-`
    | ("-" | ".") ~ arrow_direction? ~ ("0" | "(" ~ "0"? ) ~ ")"? ~ ("-" | ".") ~ arrow_head?
    // `--*`, `--o`, `--+`, `--#`, `-->>`, `--0`, `--^`, `--(0`
    //
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction? ~ ("*" | "o" | "+" | "#" | ">>" | "0" | "^")
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction? ~ "(" ~ "0"?
    | "~~"
    | "=="
}

// `A -[#red]-> B`: стиль после первой чёрточки, затем остаток линии.
arrow_style_before_line = {
    // `--[#red]>` — стиль после всей линии
    ("-" | ".")+ ~ arrow_style ~ ("-" | ".")* ~ arrow_direction? ~ arrow_head
    // `-[#red]->` — стиль после первой чёрточки
    | "-" ~ arrow_style ~ ("-" | ".")+ ~ arrow_direction? ~ arrow_head
    // `-down->` — направление без стиля
    | "-" ~ arrow_direction ~ ("-" | ".")* ~ arrow_head
}

arrow_head = { ">" | "<" | "|>" | "<|" | "*" | "o" }
arrow_style = { "[" ~ (!("]" | NEWLINE) ~ ANY)+ ~ "]" }

arrow_solid = { 
    "-->" 
    | "->" 
    // Двунаправленные стрелки проверяются ПЕРЕД однонаправленными: иначе
    // `<-` перехватывает начало `<->` и `<-->`, оставляя `>`.
    // Эти формы порождает макрос C4 `BiRel`.
    | "<-->"
    | "<->"
    // `<-down->` — двунаправленная стрелка с направлением. Проверено на
    // сервере: именно эта форма валидна, `<->down->` даёт 400.
    | "<-" ~ arrow_direction ~ "->"
    | "<--" 
    | "<-"
    // ВАЖНО: формы с ДВОЙНЫМ наконечником идут ПЕРЕД одиночными.
    // Иначе `-DOWN->>` разберётся как `-DOWN->` с остатком `>`, и связь
    // с меткой не распознается.
    //
    // `-DOWN->>` — направленная стрелка с двойным наконечником:
    // стандартная библиотека C4 строит её так: `$down("-","->>")`.
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction ~ "->" ~ ">"
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction ~ "--" ~ ">"
    | "--" ~ arrow_direction? ~ "->" ~ ">"?
    | "<-" ~ arrow_direction? ~ "--" ~ ">"?
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction ~ "->"
}

arrow_dashed = { 
    "..>" 
    | ".>" 
    | "<.." 
    | "<."
    | ".." ~ arrow_direction? ~ ".>"
    | "<." ~ arrow_direction? ~ ".."
}

// Направление связи. PlantUML принимает полные слова и двухбуквенные
// сокращения (`-ri(0)->`, `-le(0)->`, `-do(0)->`, `.up(0).>`).
// Сокращения идут ПЕРВЫМИ, иначе `ri` разберётся как `r` с остатком `i`.
arrow_direction = {
    // ВАЖНО: длинные формы идут ПЕРВЫМИ, иначе `d` съест начало `DOWN`
    // и останется `OWN`. PlantUML принимает направление в ЛЮБОМ регистре,
    // а стандартная библиотека C4 пишет ЗАГЛАВНЫМИ: `-DOWN->>`.
    "down" | "DOWN" | "Down"
    | "left" | "LEFT" | "Left"
    | "right" | "RIGHT" | "Right"
    | "up" | "UP" | "Up"
    | "ri" | "RI" | "le" | "LE" | "do" | "DO"
    | "u" | "U" | "d" | "D" | "l" | "L" | "r" | "R"
}

// Метка связи
connection_label = { ws* ~ ":" ~ ws* ~ label_text }
label_text = { (!NEWLINE ~ ANY)* }

// === Общие части ===

alias_part = { ws+ ~ "as" ~ ws+ ~ simple_identifier }

// Алиас и стереотип допустимы в ЛЮБОМ порядке: PlantUML принимает и
// `rectangle "X" as a <<person>>`, и `rectangle "X" <<person>> as a`
// (проверено на сервере). Стандартная библиотека C4 порождает вторую
// форму, и без неё весь её вывод не разбирался.
//
// Правило немое (`_`), поэтому его содержимое остаётся прямыми потомками
// объявления — парсер читает их как раньше.
name_suffix = _{ (alias_part ~ stereotype_part?) | (stereotype_part ~ alias_part?) }
stereotype_part = { ws* ~ "<<" ~ stereotype_name ~ ">>" }
stereotype_name = { (LETTER | NUMBER | "_" | " ")+ }
color_part = { ws* ~ color }

// === Заметки ===

note_stmt = {
    note_on_component
    | note_floating
    | note_multiline
}

// note left of Component : text
note_on_component = {
    "note" ~ ws+ ~ note_position ~ ws+ ~ "of" ~ ws+ ~ note_target ~ ws* ~ (":" ~ ws* ~ note_text)?
}

// note "text" as alias
note_floating = {
    "note" ~ ws+ ~ quoted_string ~ ws+ ~ "as" ~ ws+ ~ simple_identifier
}

// note left of Component
//   multi line
// end note
note_multiline = {
    "note" ~ ws+ ~ note_position ~ ws* ~ ("of" ~ ws+ ~ note_target)? ~ NEWLINE ~
    note_body ~
    "end" ~ ws+ ~ "note"
}

note_target = { bracket_component | simple_identifier }
note_position = { "left" | "right" | "top" | "bottom" }
note_text = { (!NEWLINE ~ ANY)* }
note_body = { (!("end" ~ ws+ ~ "note") ~ ANY)* }

// === Skinparam ===

skinparam = { 
    "skinparam" ~ ws+ ~ skinparam_name ~ ws+ ~ skinparam_value
    | "skinparam" ~ ws+ ~ skinparam_name ~ ws* ~ "{" ~ ws* ~ NEWLINE ~ (skinparam_line ~ NEWLINE)* ~ "}"
}

// Имя skinparam — ЛЮБОЙ токен без пробелов.
//
// Стандартная библиотека C4 использует формы, которые разбор по частям
// не покрывал:
//   `skinparam rectangle<<boundary>>`            — имя со стереотипом;
//   `skinparam package<<enterprise'_boundary'>>StereotypeFontColor transparent`
//                                                — ещё и СУФФИКС после `>>`.
// Поэтому имя — всё до пробела или `{`.
skinparam_name = @{ (!(" " | "\t" | NEWLINE | "{") ~ ANY)+ }
skinparam_value = { (!NEWLINE ~ ANY)+ }
skinparam_line = { ws* ~ skinparam_name ~ ws+ ~ skinparam_value }

// === Базовые токены ===

simple_identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }
identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

quoted_string = { "\"" ~ inner_string ~ "\"" }
inner_string = { (!("\"") ~ ANY)* }

color = { "#" ~ hex_color }
hex_color = @{ ASCII_HEX_DIGIT{3,8} }

rest_of_line = { (!NEWLINE ~ ANY)* }

// === Пробельные символы ===

ws = _{ " " | "\t" }
NEWLINE = _{ "\r\n" | "\n" | "\r" }

// Спрайт: `sprite $имя [ШxВ/цветов] { ...hex... }`.
//
// Формат, в котором распространяется стандартная библиотека иконок
// (logos, office, tupadr3). Раньше правило отсутствовало вовсе, поэтому
// 30 из 39 включений реестра не разбирались: их содержимое — это
// определения спрайтов.
sprite_stmt = {
    sprite_raster
    | sprite_svg
}

// Растровый спрайт: `sprite $имя [ШxВ/цветов] { hex-строки }`
sprite_raster = {
    "sprite" ~ ws+ ~ sprite_name ~ ws+ ~ "[" ~ sprite_size ~ "]" ~ ws* ~
    "{" ~ NEWLINE ~
    sprite_body ~
    "}"
}

// Векторный спрайт: `sprite имя <svg ...> ... </svg>`.
//
// Формат из официальной документации: имя БЕЗ `$`, тело — встроенный
// SVG. PlantUML поддерживает лишь небольшое подмножество SVG, поэтому
// файлы предварительно сжимают (например, через vecta.io/nano).
sprite_svg = {
    "sprite" ~ ws+ ~ sprite_name ~ ws+ ~ "<svg" ~ svg_attrs ~ ">" ~
    svg_body ~
    "</svg>"
}

// Имя спрайта может содержать ДЕФИСЫ: библиотека Archimate
// использует имена вида `$application-collaboration-svg`, а общее
// правило `identifier` дефис не допускает.
sprite_name = @{ "$"? ~ (LETTER | "_") ~ (LETTER | NUMBER | "_" | "-")* }
svg_attrs = @{ (!(">" | NEWLINE) ~ ANY)* }
svg_body = { (!"</svg>" ~ ANY)* }

sprite_size = @{ (!("]" | NEWLINE) ~ ANY)+ }
sprite_body = { (!("}" ~ NEWLINE? ~ ("@" | "sprite" | NEWLINE? ~ ANY)) ~ ANY)* }

// Блок стилей: `<style> ... </style>`.
//
// PlantUML применяет его к элементам диаграммы; содержимое — CSS-подобные
// правила. Раньше правило отсутствовало, и диаграмма со `<style>` не
// разбиралась вовсе — из-за этого, например, не подключалась библиотека
// Archimate, которая начинает вывод с такого блока.
//
// Содержимое пропускается: поддержка самих правил — отдельная задача.
style_stmt = { "<style>" ~ NEWLINE ~ style_body ~ "</style>" ~ ws* ~ NEWLINE? }
style_body = { (!("</style>") ~ ANY)* }
