// Грамматика PlantUML Component Diagrams
// https://plantuml.com/component-diagram

// === Основные правила ===

diagram = { SOI ~ NEWLINE* ~ start_tag ~ NEWLINE* ~ body ~ end_tag ~ NEWLINE* ~ EOI }

start_tag = { "@startuml" ~ identifier? }
end_tag = { "@enduml" }

body = { (ws* ~ statement ~ NEWLINE*)* }

// ВАЖНО: Порядок правил критичен!
// 1. package_def должна идти ДО component_def, чтобы node/cloud с телом {} парсились как контейнеры
// 2. connection должна идти ПОСЛЕ component_def, чтобы bracket_component парсился корректно
statement = _{
    comment
    | skinparam
    | title_stmt
    | hide_stmt
    | scale_stmt
    | package_def
    | nested_package_def
    | interface_def
    | archimate_def
    | connection
    | component_def
    | note_stmt
}

// === Archimate ===
// archimate #Layer "Name" as alias
// Слой задаёт цвет и стереотип элемента; поддерживаемые слои PlantUML:
// Business, Application, Technology, Motivation, Strategy, Physical,
// Implementation.
archimate_def = {
    "archimate" ~ ws+ ~ archimate_layer ~ ws+ ~ quoted_string ~
    (ws+ ~ "as" ~ ws+ ~ identifier)?
}

archimate_layer = @{ "#" ~ (ASCII_ALPHA)+ }

// === Комментарии ===

comment = { "'" ~ (!NEWLINE ~ ANY)* }

// === Заголовок и настройки ===

title_stmt = { "title" ~ ws+ ~ rest_of_line }
hide_stmt = { "hide" ~ ws+ ~ rest_of_line }
scale_stmt = { "scale" ~ ws+ ~ rest_of_line }

// === Определение компонента ===

// Простой компонент без тела: component Name, [Component], database DB
// Компоненты с телом {} обрабатываются через package_def/nested_package_def
// ВАЖНО: Используем negative lookahead чтобы не захватывать node/folder/frame с телом {}
component_def = {
    container_keyword ~ ws+ ~ component_name ~ alias_part? ~ stereotype_part? ~ color_part? ~ !("{")
    // `device`/`agent` могут быть и контейнерами (с телом) — тогда их
    // разбирает package_def. Здесь они принимаются только БЕЗ тела.
    | non_container_keyword ~ ws+ ~ component_name ~ alias_part? ~ stereotype_part? ~ color_part?
        ~ !(ws* ~ "{" ~ NEWLINE)
    | bracket_component ~ alias_part? ~ stereotype_part? ~ color_part?
}

// Ключевые слова, которые МОГУТ быть контейнерами (с телом {})
// Для них нужна проверка на отсутствие { чтобы отличить компонент от контейнера
// Ключевые слова, которые могут быть КОНТЕЙНЕРАМИ (принимать тело).
//
// Список сверен с официальной документацией (plantuml.com/en/deployment-diagram,
// раздел «Nestable elements»): action, artifact, card, cloud, component,
// database, file, folder, frame, hexagon, node, package, process, queue,
// rectangle, stack, storage.
//
// `collections` в него НЕ входит: у него тела не бывает.
container_keyword = {
    "node"
    | "folder"
    | "frame"
    | "cloud"
    | "rectangle"
    | "database"
    | "storage"
    | "queue"
    | "file"
    | "artifact"
    | "card"
    | "hexagon"
    | "stack"
    | "action"
    | "process"
    | "component"
}

// Ключевые слова, которые НЕ могут быть контейнерами (всегда компоненты)
// Элементы, которые телом НЕ обладают.
//
// `device` убран: такого ключевого слова в PlantUML нет — сервер отвечает
// 400 на любую форму (`device D1`, `device "D" as d`, `device D { ... }`),
// и в официальном списке объявляемых элементов его тоже нет.
// Добавлены отсутствовавшие circle, label, person, collections.
non_container_keyword = {
    "component"
    | "actor"
    | "agent"
    | "control"
    | "boundary"
    | "entity"
    | "circle"
    | "label"
    | "person"
    | "collections"
}

// Ключевые слова для типов компонентов (все вместе для parse_component_type)
component_keyword = {
    container_keyword | non_container_keyword
}

// [Component Name] синтаксис
bracket_component = { "[" ~ bracket_content ~ "]" }
bracket_content = { (!"]" ~ ANY)+ }

component_name = { quoted_string | simple_identifier }

// === Определение интерфейса ===

interface_def = {
    interface_provided
    | interface_required
    | interface_simple
}

// () Interface - предоставляемый
interface_provided = { "()" ~ ws* ~ interface_name ~ alias_part? }

// ( Interface - требуемый (полукруг)
interface_required = { "(" ~ ws* ~ interface_name ~ ws* ~ ")" ~ alias_part? }

// interface Name
interface_simple = { "interface" ~ ws+ ~ interface_name ~ alias_part? ~ stereotype_part? }

interface_name = { quoted_string | simple_identifier }

// === Пакеты/контейнеры ===

// Основной package (верхнего уровня или вложенный)
package_def = {
    package_keyword ~ ws+ ~ package_name ~ alias_part? ~ stereotype_part? ~ color_part? ~ ws* ~ "{" ~ NEWLINE ~
    package_body ~
    "}"
}

// Вложенный package (может содержать другие packages)
nested_package_def = {
    nested_package_keyword ~ ws+ ~ package_name ~ alias_part? ~ stereotype_part? ~ color_part? ~ ws* ~ "{" ~ NEWLINE ~
    package_body ~
    "}"
}

// Тело пакета может содержать вложенные пакеты
// Используем negative lookahead чтобы остановиться перед закрывающей скобкой
// Пустые строки (только пробелы и переводы строк) игнорируются
package_body = { (package_line)* ~ ws* }

// Строка внутри пакета: либо statement, либо пустая строка
package_line = _{
    ws* ~ !("}" ~ NEWLINE?) ~ package_statement ~ NEWLINE*
    | ws* ~ NEWLINE  // пустая строка
}

package_statement = _{
    comment
    | skinparam
    | nested_package_def
    | package_def
    | interface_def
    | connection
    | component_def
    | note_stmt
}

// Контейнерные ключевые слова. Ссылаемся на `container_keyword`, чтобы
// списки не разъезжались: раньше это был отдельный перечень, и добавление
// `action`/`process` в один список не давало эффекта во втором.
//
// `collections` здесь больше нет: тела он не принимает.
package_keyword = {
    "package"
    | container_keyword
}

// Ключевые слова, которые могут быть и компонентом, и контейнером
nested_package_keyword = {
    "node"
    | "folder"
    | "frame"
}

package_name = { quoted_string | simple_identifier }

// === Связи ===

connection = {
    connection_from ~ ws* ~ arrow ~ ws* ~ connection_to ~ connection_label?
}

// Имя конца связи. Поддерживается и quoted-форма: связи между элементами
// с именами в кавычках (`"app.jar" --> pg`) — обычная запись PlantUML,
// раньше такие связи не разбирались вовсе.
connection_end = _{
    bracket_component
    | interface_ref
    | quoted_string
    | simple_identifier
}

connection_from = { connection_end }

connection_to = { connection_end }

// Ссылка на интерфейс
interface_ref = { "()" ~ ws* ~ simple_identifier | "(" ~ simple_identifier ~ ")" }

// Стрелки
// Между сторонами стрелки может стоять стиль линии: `-[#red]->`,
// `-[dashed]->`. Раньше такие связи не разбирались вовсе.
arrow = {
    arrow_style_before_line
    // Украшенные связи проверяются ПЕРЕД обычными: иначе `-->>` разберётся
    // как `-->` с остатком `>`, а `-0-` — как `-0` с остатком `-`.
    | arrow_decorated
    | arrow_dashed
    | arrow_solid
    // Простая ассоциация со стилем, но без наконечника: `A -- B`, `A -[#red]- B`.
    | ("-" | "." | "~" | "=")+ ~ arrow_style ~ ("-" | "." | "~" | "=")*
    // Ассоциация без наконечника и без стиля: `A -- B`, `A ~~ B`, `A == B`.
    | ("-" | "." | "~" | "="){1,3}
}

// Связи с украшением на конце: `--*`, `--o`, `--+`, `--#`, `-->>`,
// `--0`, `--^`, `--(0`, а также «кружковые» `-0-`, `-0)-`, `-(0-`,
// `-(0)-` и линии `~~`, `==`.
arrow_decorated = {
    // Кружковые связи проверяются первыми: иначе `-0-` разберётся как
    // украшение `-0` с остатком `-`.
    //
    // `<-0->`, `<-0)-`, `<-(0)->`
    "<" ~ ("-" | ".") ~ ("0" | "(" ~ "0"? ) ~ ")"? ~ ("-" | ".") ~ arrow_head?
    | "<" ~ ("0" | "(" ~ "0"? ) ~ ")"? ~ ("-" | ".") ~ arrow_head?
    // `-0-`, `-0)-`, `-(0-`, `-(0)-`
    | ("-" | ".") ~ arrow_direction? ~ ("0" | "(" ~ "0"? ) ~ ")"? ~ ("-" | ".") ~ arrow_head?
    // `--*`, `--o`, `--+`, `--#`, `-->>`, `--0`, `--^`, `--(0`
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction? ~ ("*" | "o" | "+" | "#" | ">>" | "0" | "^")
    | ("-" | "." | "~" | "="){1,3} ~ arrow_direction? ~ "(" ~ "0"?
    | "~~"
    | "=="
}

// `A -[#red]-> B`: стиль после первой чёрточки, затем остаток линии.
arrow_style_before_line = {
    // `--[#red]>` — стиль после всей линии
    ("-" | ".")+ ~ arrow_style ~ ("-" | ".")* ~ arrow_direction? ~ arrow_head
    // `-[#red]->` — стиль после первой чёрточки
    | "-" ~ arrow_style ~ ("-" | ".")+ ~ arrow_direction? ~ arrow_head
    // `-down->` — направление без стиля
    | "-" ~ arrow_direction ~ ("-" | ".")* ~ arrow_head
}

arrow_head = { ">" | "<" | "|>" | "<|" | "*" | "o" }
arrow_style = { "[" ~ (!("]" | NEWLINE) ~ ANY)+ ~ "]" }

arrow_solid = { 
    "-->" 
    | "->" 
    | "<--" 
    | "<-"
    | "--" ~ arrow_direction? ~ "->"
    | "<-" ~ arrow_direction? ~ "--"
}

arrow_dashed = { 
    "..>" 
    | ".>" 
    | "<.." 
    | "<."
    | ".." ~ arrow_direction? ~ ".>"
    | "<." ~ arrow_direction? ~ ".."
}

// Направление связи. PlantUML принимает полные слова и двухбуквенные
// сокращения (`-ri(0)->`, `-le(0)->`, `-do(0)->`, `.up(0).>`).
// Сокращения идут ПЕРВЫМИ, иначе `ri` разберётся как `r` с остатком `i`.
arrow_direction = {
    "down" | "left" | "right" | "up" | "ri" | "le" | "do" | "u" | "d" | "l" | "r"
}

// Метка связи
connection_label = { ws* ~ ":" ~ ws* ~ label_text }
label_text = { (!NEWLINE ~ ANY)* }

// === Общие части ===

alias_part = { ws+ ~ "as" ~ ws+ ~ simple_identifier }
stereotype_part = { ws* ~ "<<" ~ stereotype_name ~ ">>" }
stereotype_name = { (LETTER | NUMBER | "_" | " ")+ }
color_part = { ws* ~ color }

// === Заметки ===

note_stmt = {
    note_on_component
    | note_floating
    | note_multiline
}

// note left of Component : text
note_on_component = {
    "note" ~ ws+ ~ note_position ~ ws+ ~ "of" ~ ws+ ~ note_target ~ ws* ~ (":" ~ ws* ~ note_text)?
}

// note "text" as alias
note_floating = {
    "note" ~ ws+ ~ quoted_string ~ ws+ ~ "as" ~ ws+ ~ simple_identifier
}

// note left of Component
//   multi line
// end note
note_multiline = {
    "note" ~ ws+ ~ note_position ~ ws* ~ ("of" ~ ws+ ~ note_target)? ~ NEWLINE ~
    note_body ~
    "end" ~ ws+ ~ "note"
}

note_target = { bracket_component | simple_identifier }
note_position = { "left" | "right" | "top" | "bottom" }
note_text = { (!NEWLINE ~ ANY)* }
note_body = { (!("end" ~ ws+ ~ "note") ~ ANY)* }

// === Skinparam ===

skinparam = { 
    "skinparam" ~ ws+ ~ skinparam_name ~ ws+ ~ skinparam_value
}

skinparam_name = { (LETTER | NUMBER | "_")+ }
skinparam_value = { (!NEWLINE ~ ANY)+ }

// === Базовые токены ===

simple_identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }
identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

quoted_string = { "\"" ~ inner_string ~ "\"" }
inner_string = { (!("\"") ~ ANY)* }

color = { "#" ~ hex_color }
hex_color = @{ ASCII_HEX_DIGIT{3,8} }

rest_of_line = { (!NEWLINE ~ ANY)* }

// === Пробельные символы ===

ws = _{ " " | "\t" }
NEWLINE = _{ "\r\n" | "\n" | "\r" }
