// Грамматика для Salt (Wireframe) диаграмм
//
// Синтаксис:
// @startsalt
// {+
//   Login    | "MyName   "
//   Password | "****     "
//   [Cancel] | [  OK   ]
// }
// @endsalt

// Точка входа
salt_diagram = { SOI ~ WHITESPACE* ~ container ~ WHITESPACE* ~ EOI }

// Контейнер - основной блок
container = { "{" ~ border_style? ~ WHITESPACE* ~ container_content ~ WHITESPACE* ~ "}" }

// Стиль границ
border_style = { 
    "#" | "!" | "+" | 
    "^" ~ quoted_title? |
    "S" ~ scroll_modifier? | 
    "T" ~ table_modifier? | 
    "/" | "*" |
    "-"
}

// Модификатор скролла
scroll_modifier = { "I" | "-" }

// Модификатор таблицы
table_modifier = { "#" | "!" | "-" | "+" }

// Заголовок группы
quoted_title = { "\"" ~ title_content ~ "\"" }
title_content = @{ (!("\"") ~ ANY)* }

// Содержимое контейнера (строки разделённые переносами)
container_content = { (row ~ (NEWLINE+ ~ row)*)? }

// Строка (ячейки разделённые |)
row = { WHITESPACE* ~ cell ~ ("|" ~ cell)* ~ WHITESPACE* }

// Ячейка.
//
// После виджета может идти его подпись: `(X) Да`, `[X] Включено`,
// `[Кнопка]`. Раньше ячейка допускала ровно один виджет, поэтому
// переключатели и флажки С ПОДПИСЬЮ — самая обычная запись — не
// разбирались вовсе.
cell = { WHITESPACE* ~ labeled_widget? ~ WHITESPACE* }

// Виджет с необязательной подписью.
//
// Подпись приклеена к самому виджету, а не к ячейке, и НЕ требует
// отдельного `WHITESPACE+` перед собой: немое правило `WHITESPACE` —
// немое (`_`), и повторение `WHITESPACE+` после виджета не срабатывало,
// из-за чего `(X) Да` и `[X] Включено` — самая обычная запись — не
// разбирались вовсе. Подпись сама поглощает ведущий пробел.
labeled_widget = {
    (radio_checked | radio_unchecked | checkbox_checked | checkbox_unchecked) ~ widget_label?
    | widget
}

// Подпись виджета: всё до конца ячейки.
widget_label = { (!("|" | NEWLINE) ~ ANY)+ }

// Виджет
widget = _{
    container |
    button |
    textfield |
    checkbox_checked |
    checkbox_unchecked |
    radio_checked |
    radio_unchecked |
    droplist |
    separator |
    tree_item |
    coordinate_text |
    plain_text
}

// Кнопка [text]
//
// Составное-атомарное правило (`$`), а не обычное: pest сам пропускает
// пробелы между токенами, и на границе `"["` и `button_content` терялся
// ВЕДУЩИЙ пробел подписи. PlantUML считает ширину кнопки по числу
// символов, поэтому «[ OK ]» обязана остаться четырёхсимвольной.
button = ${ "[" ~ button_content ~ "]" }
button_content = @{ (!("]") ~ !NEWLINE ~ ANY)* }

// Текстовое поле "text"
textfield = ${ "\"" ~ textfield_content ~ "\"" }
textfield_content = @{ (!("\"") ~ !NEWLINE ~ ANY)* }

// Чекбокс отмеченный [X] или [x]
checkbox_checked = { "[" ~ WHITESPACE* ~ ("X" | "x") ~ WHITESPACE* ~ "]" }

// Чекбокс неотмеченный [ ]
checkbox_unchecked = { "[" ~ WHITESPACE* ~ "]" }

// Радио отмеченная (X) или (x)
radio_checked = { "(" ~ WHITESPACE* ~ ("X" | "x") ~ WHITESPACE* ~ ")" }

// Радио неотмеченная ()
radio_unchecked = { "(" ~ WHITESPACE* ~ ")" }

// Выпадающий список ^item^
droplist = { "^" ~ droplist_item ~ "^" ~ ("^" ~ droplist_item ~ "^")* }
droplist_item = @{ (!("^") ~ !NEWLINE ~ ANY)* }

// Координата вида (0,0) или (10,40) — ОБЫЧНЫЙ ТЕКСТ.
//
// PlantUML не рисует для неё ни рамки, ни скроллбара: в эталоне
// `salt_widgets` это три подписи в строке — «Журнал», «(0,0)», «(10,40)».
// Раньше такая ячейка не разбиралась вовсе: пара координат не является
// радио-кнопкой (радио требует `)` сразу после `(`), а `plain_text`
// исключает `(`. Правило добавлено ДО separator, чтобы проверяться
// раньше plain_text.
//
// Настоящая область прокрутки задаётся границей `{S}`, `{SI}` или
// `{S-}` и разбирается как обычный контейнер через `border_style`.
coordinate_text = @{ "(" ~ (!(")") ~ !NEWLINE ~ ANY)+ ~ ")" }

// Разделители
separator = { double_line | dotted_line | wavy_line | single_line }
double_line = { "==" ~ "="* }
dotted_line = { ".." ~ "."* }
wavy_line = { "~~" ~ "~"* }
single_line = { "--" ~ "-"* }

// Элемент дерева (используется внутри {T})
tree_item = { "+"+ ~ WHITESPACE* ~ tree_text }
tree_text = @{ (!NEWLINE ~ !("|") ~ !("}") ~ ANY)* }



// Обычный текст (не содержит специальных символов)
plain_text = @{ (!NEWLINE ~ !("|") ~ !("}") ~ !("[") ~ !("\"") ~ !("(") ~ !("^") ~ !("{") ~ !("==" | ".." | "~~" | "--") ~ ANY)+ }

// Пробельные символы
WHITESPACE = _{ " " | "\t" | "\r" }
NEWLINE = { "\n" }
