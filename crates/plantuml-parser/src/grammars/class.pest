// Грамматика PlantUML Class Diagrams
// https://plantuml.com/class-diagram

// === Основные правила ===

diagram = { SOI ~ NEWLINE* ~ start_tag ~ NEWLINE* ~ (ws* ~ statement? ~ NEWLINE)* ~ ws* ~ end_tag ~ NEWLINE* ~ EOI }

start_tag = { "@startuml" ~ identifier? }
end_tag = { "@enduml" }

statement = _{
    comment
    | skinparam
    | title_stmt
    | hide_stmt
    | show_stmt
    | package_start
    | package_end
    | namespace_start
    | namespace_end
    | together_start
    | together_end
    | class_decl
    | interface_decl
    | abstract_decl
    | enum_decl
    | direction_stmt
    | scale_stmt
    | annotation_decl
    | sprite_stmt
    | style_stmt
    | note_stmt
    | class_description
    | relationship
}

// Описание элемента: `A : текст` или `A : <$спрайт>`.
//
// PlantUML добавляет строку к телу класса такой записью. Раньше правила
// не было вовсе, поэтому `A : текст` не разбиралось.
class_description = { (identifier | quoted_string) ~ ws* ~ ":" ~ ws* ~ description_text }
description_text = { (!NEWLINE ~ ANY)+ }

// === Заметки ===
// В PlantUML заметки есть у всех UML-диаграмм. Раньше класс их не знал
// вовсе, и `note right of A : текст` не разбирался.

// Порядок важен: многострочная форма проверяется ПЕРВОЙ, иначе
// `note right of A` без двоеточия перехватывается однострочным правилом,
// и следующая строка с текстом оказывается неожиданной.
note_stmt = {
    note_multiline
    | note_on_element
    | note_floating
}

// note right of A : text
note_on_element = {
    "note" ~ ws+ ~ note_position ~ ws+ ~ "of" ~ ws+ ~ note_target ~ ws* ~ (":" ~ ws* ~ note_text)?
}

// note "text" as alias
note_floating = {
    "note" ~ ws+ ~ quoted_string ~ ws+ ~ "as" ~ ws+ ~ identifier
}

// note right of A
//   многострочный текст
// end note
note_multiline = {
    "note" ~ ws+ ~ note_position ~ ws* ~ ("of" ~ ws+ ~ note_target)? ~ NEWLINE ~
    note_body ~
    "end" ~ ws+ ~ "note"
}

note_target = { quoted_string | qualified_name }
note_position = { "left" | "right" | "top" | "bottom" }
note_text = { (!NEWLINE ~ ANY)* }
note_body = { (!("end" ~ ws+ ~ "note") ~ ANY)* }

// === Комментарии ===

// Комментарии: строчный `' текст` и БЛОЧНЫЙ `/' ... '/`.
//
// Блочная форма встречается в стандартной библиотеке — например в C4
// (`/' @deprecated in favor of UpdateElementStyle '/`). Без неё разбор
// диаграмм с таким включением падал.
comment = {
    line_comment
    | block_comment
}
line_comment = { "'" ~ (!NEWLINE ~ ANY)* }
block_comment = { "/'" ~ (!"'/" ~ ANY)* ~ "'/" }

// === Заголовок ===

title_stmt = { "title" ~ ws+ ~ rest_of_line }

// === Hide/Show ===

hide_stmt = { "hide" ~ ws+ ~ hide_show_target }
show_stmt = { "show" ~ ws+ ~ hide_show_target }
hide_show_target = { 
    ("empty" ~ ws+)? ~ ("members" | "fields" | "methods" | "attributes" | "circle" | "stereotype")
    | identifier
}

// === Пакеты и Namespaces ===

package_start = { "package" ~ ws+ ~ package_name ~ (ws+ ~ package_style)? ~ (ws+ ~ color)? ~ ws* ~ "{" }
package_end = { "}" }

package_name = { quoted_string | identifier }
package_style = { "<<" ~ identifier ~ ">>" }

namespace_start = { "namespace" ~ ws+ ~ identifier ~ (ws+ ~ color)? ~ ws* ~ "{" }
namespace_end = { "}" }

// === Together ===

together_start = { "together" ~ ws* ~ "{" }
together_end = { "}" }

// === Классы ===

class_decl = {
    class_keyword ~ ws+ ~ class_name ~
    alias_part? ~
    (ws* ~ generic_params)? ~
    (ws* ~ stereotype)? ~
    (ws* ~ extends_clause)? ~
    (ws* ~ implements_clause)? ~
    (ws+ ~ color)? ~
    (ws* ~ link_part)? ~
    (ws* ~ class_body)?
}

class_keyword = { "abstract"? ~ ws* ~ "class" }

// Алиас объявления: `class "Длинное имя" as short`. PlantUML принимает
// алиас у всех объявлений; в class-грамматике его не было вовсе.
alias_part = { ws+ ~ "as" ~ ws+ ~ (identifier | quoted_string) }

interface_decl = {
    "interface" ~ ws+ ~ class_name ~
    alias_part? ~
    (ws* ~ generic_params)? ~
    (ws* ~ stereotype)? ~
    (ws+ ~ color)? ~
    (ws* ~ class_body)?
}

abstract_decl = {
    "abstract" ~ ws+ ~ class_name ~
    (ws* ~ generic_params)? ~
    (ws* ~ stereotype)? ~
    (ws+ ~ color)? ~
    (ws* ~ class_body)?
}

enum_decl = {
    "enum" ~ ws+ ~ class_name ~
    alias_part? ~
    (ws* ~ stereotype)? ~
    (ws+ ~ color)? ~
    (ws* ~ enum_body)?
}

annotation_decl = {
    "annotation" ~ ws+ ~ class_name ~
    alias_part? ~
    (ws* ~ stereotype)? ~
    (ws+ ~ color)? ~
    (ws* ~ class_body)?
}

class_name = { quoted_string | qualified_name }

// Гиперссылка на элементе: `class A [[http://example.com]]`.
// PlantUML оборачивает элемент в <a>, а без этого правила строка не
// разбиралась вовсе.
link_part = { "[[" ~ link_url ~ "]]" }
link_url = { (!("]]") ~ ANY)+ }
qualified_name = @{ identifier ~ ("." ~ identifier)* }

generic_params = { "<" ~ generic_type ~ ("," ~ ws* ~ generic_type)* ~ ">" }
generic_type = { identifier ~ (ws* ~ extends_bound)? }
extends_bound = { "extends" ~ ws+ ~ identifier }

extends_clause = { "extends" ~ ws+ ~ class_name }
implements_clause = { "implements" ~ ws+ ~ class_name ~ ("," ~ ws* ~ class_name)* }

// === Тело класса ===

class_body = { "{" ~ ws* ~ NEWLINE* ~ (ws* ~ member ~ NEWLINE*)* ~ ws* ~ "}" }

member = {
    separator
    | method    // method должен идти ПЕРЕД field (из-за скобок)
    | field
    | free_line // произвольная строка — ПОСЛЕ field, иначе перехватит поля
}

// Произвольная строка тела класса.
//
// PlantUML разрешает в теле любую строку, в том числе со вставкой
// спрайта: `текст <$имя>`. Правила `field`/`method` требуют имени,
// начинающегося с буквы, поэтому такая строка ими не покрывается.
//
// ВАЖНО: правило стоит ПОСЛЕ `field`. Первая версия ставила его перед
// полем, и тогда `-id: Long` разбиралось как свободная строка, а поля
// исчезали из вывода (высота класса падала со 121 до 80).
free_line = { (!NEWLINE ~ !"}" ~ ANY)+ }

// Разделители в теле класса:
// -- или -- text -- (сплошная линия)
// .. или .. text .. (пунктирная линия)  
// __ или __ text __ (жирная линия)
// == или == text == (двойная линия)
separator = { 
    ".." ~ separator_text? ~ ("..")? 
    | "--" ~ separator_text? ~ ("--")? 
    | "__" ~ separator_text? ~ ("__")? 
    | "==" ~ separator_text? ~ ("==")?
}
separator_text = { (!NEWLINE ~ !".." ~ !"--" ~ !"__" ~ !"==" ~ ANY)+ }

// Метод - ищем по наличию скобок ()
// Модификаторы ({abstract}, {static}) могут идти ДО или ПОСЛЕ visibility
method = {
    (modifier ~ ws*)* ~
    visibility? ~ ws* ~
    (modifier ~ ws+)* ~
    method_name ~ ws* ~
    "(" ~ ws* ~ method_params? ~ ws* ~ ")" ~
    (ws* ~ ":" ~ ws* ~ return_type)?
}

// Поле - всё что НЕ является методом (нет скобок)
// Модификаторы ({abstract}, {static}) могут идти ДО или ПОСЛЕ visibility
field = { 
    (modifier ~ ws*)* ~
    visibility? ~ ws* ~ 
    (modifier ~ ws+)* ~
    field_name ~ 
    !("(") ~    // Убедиться что это не метод
    (ws* ~ ":" ~ ws* ~ field_type)?
}

visibility = { "+" | "-" | "#" | "~" | "{method}" | "{field}" }
modifier = { "{static}" | "{abstract}" | "static" | "abstract" }

field_name = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }
field_type = { sprite_inline | (!NEWLINE ~ !("}" | ",") ~ ANY)+ }

// Вставка спрайта в подписи: `<$имя>`. PlantUML рисует её растром
// прямо внутри строки текста.
sprite_inline = { "<$" ~ (!(">") ~ ANY)+ ~ ">" }

method_name = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }
method_params = { method_param ~ ("," ~ ws* ~ method_param)* }
method_param = { param_name ~ (ws* ~ ":" ~ ws* ~ param_type)? }
param_name = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }
param_type = { (!("," | ")" | NEWLINE) ~ ANY)+ }
return_type = { (!NEWLINE ~ !"}" ~ ANY)+ }

// === Enum body ===

enum_body = { "{" ~ ws* ~ NEWLINE* ~ (ws* ~ enum_value ~ NEWLINE*)* ~ ws* ~ "}" }
enum_value = { identifier }

// === Отношения ===

relationship = {
    class_ref ~ (ws+ ~ cardinality)? ~ ws* ~
    relationship_arrow ~ ws* ~
    (cardinality ~ ws+)? ~ class_ref ~
    (ws* ~ ":" ~ ws* ~ relationship_label)?
}

class_ref = { qualified_name | quoted_string }

// Кардинальность (multiplicity): "1", "*", "0..1", "1..*", etc.
cardinality = { "\"" ~ cardinality_value ~ "\"" }
cardinality_value = @{ (!"\"" ~ ANY)+ }

// Типы отношений:
// <|-- наследование (inheritance)
// <|.. реализация (implementation) 
// *-- композиция (composition)
// o-- агрегация (aggregation)
// --> зависимость (dependency)
// ..> использование (use)
// --  связь (association)

// Между сторонами стрелки может стоять стиль линии: `-[#red]->`,
// `-[dashed]->`, `-[bold]->`. Раньше такие связи не разбирались вовсе.
// Стиль линии может стоять ВНУТРИ стрелки: базовая `-->` превращается в
// `-[#red]->` (стиль после первой чёрточки) или `--[#red]>` (после всей
// линии). Поэтому после стиля допускается остаток линии до наконечника.
relationship_arrow = {
    arrow_left_side ~ arrow_line ~ arrow_style ~ arrow_rest? ~ arrow_right_side
    | arrow_left_side ~ arrow_line ~ arrow_right_side
}

// Остаток линии после вставленного стиля (`-[#red]->`).
arrow_rest = @{ ("-" | ".")+ }

// `[#red]`, `[dashed]`, `[bold]`, `[#red,dashed]` и их комбинации.
arrow_style = { "[" ~ arrow_style_body ~ "]" }
arrow_style_body = @{ (!("]" | NEWLINE) ~ ANY)+ }

arrow_left_side = {
    "<|" | "<" | "*" | "o" | "#" | "x" | "}" | "+" | "^" | ""
}

arrow_line = @{
    "--" | ".." | "-" | "."
}

arrow_right_side = {
    "|>" | ">" | "*" | "o" | "#" | "x" | "{" | "+" | "^" | ""
}

relationship_label = { (!NEWLINE ~ ANY)* }

// === Skinparam ===

skinparam = { 
    "skinparam" ~ ws+ ~ skinparam_name ~ ws+ ~ skinparam_value
    | "skinparam" ~ ws+ ~ skinparam_name ~ ws* ~ "{" ~ ws* ~ NEWLINE ~ (skinparam_line ~ NEWLINE)* ~ "}"
}

skinparam_name = { (LETTER | "_")+ }
skinparam_value = { (!NEWLINE ~ ANY)+ }
skinparam_line = { ws* ~ skinparam_name ~ ws+ ~ skinparam_value }

// === Базовые токены ===

identifier = @{ (LETTER | "_") ~ (LETTER | NUMBER | "_")* }

quoted_string = { "\"" ~ inner_string ~ "\"" }
inner_string = { (!("\"") ~ ANY)* }

stereotype = { "<<" ~ (!(">>") ~ ANY)* ~ ">>" }

color = { "#" ~ hex_color }
hex_color = @{ ASCII_HEX_DIGIT{3,8} }

rest_of_line = { (!NEWLINE ~ ANY)* }

// === Пробельные символы ===

ws = _{ " " | "\t" }
NEWLINE = _{ "\r\n" | "\n" | "\r" }

// Направление раскладки: `top to bottom direction`, `left to right direction`.
// Ключевое слово было только в usecase-грамматике; в class и sequence
// такие строки не разбирались вовсе.
direction_stmt = { direction_kind ~ ws+ ~ "direction" }
direction_kind = { "top" ~ ws+ ~ "to" ~ ws+ ~ "bottom" | "left" ~ ws+ ~ "to" ~ ws+ ~ "right" }

// Масштаб диаграммы: `scale 2`, `scale 1.5`, `scale 200 width`.
// В sequence и class правила не было вовсе.
scale_stmt = { "scale" ~ ws+ ~ rest_of_line }

// Спрайт: `sprite $имя [ШxВ/цветов] { ...hex... }`.
//
// Формат, в котором распространяется стандартная библиотека иконок
// (logos, office, tupadr3). Раньше правило отсутствовало вовсе, поэтому
// 30 из 39 включений реестра не разбирались: их содержимое — это
// определения спрайтов.
sprite_stmt = {
    sprite_raster
    | sprite_svg
}

// Растровый спрайт: `sprite $имя [ШxВ/цветов] { hex-строки }`
sprite_raster = {
    "sprite" ~ ws+ ~ sprite_name ~ ws+ ~ "[" ~ sprite_size ~ "]" ~ ws* ~
    "{" ~ NEWLINE ~
    sprite_body ~
    "}"
}

// Векторный спрайт: `sprite имя <svg ...> ... </svg>`.
//
// Формат из официальной документации: имя БЕЗ `$`, тело — встроенный
// SVG. PlantUML поддерживает лишь небольшое подмножество SVG, поэтому
// файлы предварительно сжимают (например, через vecta.io/nano).
sprite_svg = {
    "sprite" ~ ws+ ~ sprite_name ~ ws+ ~ "<svg" ~ svg_attrs ~ ">" ~
    svg_body ~
    "</svg>"
}

// Имя спрайта может содержать ДЕФИСЫ: библиотека Archimate
// использует имена вида `$application-collaboration-svg`, а общее
// правило `identifier` дефис не допускает.
sprite_name = @{ "$"? ~ (LETTER | "_") ~ (LETTER | NUMBER | "_" | "-")* }
svg_attrs = @{ (!(">" | NEWLINE) ~ ANY)* }
svg_body = { (!"</svg>" ~ ANY)* }

sprite_size = @{ (!("]" | NEWLINE) ~ ANY)+ }
sprite_body = { (!("}" ~ NEWLINE? ~ ("@" | "sprite" | NEWLINE? ~ ANY)) ~ ANY)* }

// Блок стилей: `<style> ... </style>`.
//
// PlantUML применяет его к элементам диаграммы; содержимое — CSS-подобные
// правила. Раньше правило отсутствовало, и диаграмма со `<style>` не
// разбиралась вовсе — из-за этого, например, не подключалась библиотека
// Archimate, которая начинает вывод с такого блока.
//
// Содержимое пропускается: поддержка самих правил — отдельная задача.
style_stmt = { "<style>" ~ NEWLINE ~ style_body ~ "</style>" ~ ws* ~ NEWLINE? }
style_body = { (!("</style>") ~ ANY)* }
