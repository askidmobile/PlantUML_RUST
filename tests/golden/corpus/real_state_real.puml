@startuml
[*] --> Черновик
state Черновик {
  [*] --> Правка
  Правка --> Проверка : сохранить
  Проверка --> Правка : ошибка
}
Черновик --> Опубликовано : publish
state fork_s <<fork>>
Опубликовано --> fork_s
fork_s --> Архив
fork_s --> Индекс
Архив --> [*]
Индекс --> [*]
note right of Опубликовано : Видно всем
@enduml
