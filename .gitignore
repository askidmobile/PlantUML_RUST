# Rust / Cargo
/target/
**/*.rs.bk
# Cargo.lock отслеживается: он закрепляет версии зависимостей,
# от которых зависит MSRV-гейт в CI (см. rust-version в Cargo.toml).
# Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.so
*.rlib
*.dll
*.dylib
*.exe

# Test artifacts
*.profraw
*.profdata
coverage/
tarpaulin-report.html

# Documentation
/doc/
/docs/api/

# Справочник PlantUML в PDF (10.5 МБ, 88% трекаемого контента).
# Оставлен локально, в репозитории не нужен: это внешняя документация,
# доступная на plantuml.com/guide. Скачать:
#   curl -o docs/PlantUML.pdf https://plantuml.com/PlantUML_Language_Reference_Guide.pdf
/docs/PlantUML.pdf

# WASM build: /pkg/ — артефакт wasm-pack в корне (не создаётся ни одним workflow).
# Целевая директория деплоя — playground/pkg, она игнорируется через playground/.gitignore.
/pkg/
/dist/

# Node.js (для WASM пакета)
node_modules/
npm-debug.log
yarn-error.log

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Benchmark results
/criterion/
*.bench

# Snapshots (insta)
# Не игнорируем - они должны быть в репозитории
# *.snap.new

# OS files
Thumbs.db
.DS_Store

# Editor backups
*~
\#*\#
.\#*

# Profiling
perf.data
perf.data.old
flamegraph.svg

# Generated SVG output files (test results)
output_*.svg

# Отладочные артефакты рендеринга в корне репозитория (не коммитить)
/*.png
/our_*.svg
/test_ref_example.rs

# Visual comparison test images (generated during testing)
tests/visual/**/*_test.png
tests/visual/**/our_*.svg
tests/visual/**/our_*.png

# Keep original reference images
!tests/visual/**/original_*.svg
!tests/visual/**/original_*.png
